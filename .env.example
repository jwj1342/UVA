# Copy to .env and fill in. scripts/env.sh sources this file when it exists.

# The student, served by vLLM (scripts/serve_student.sh) as an OpenAI-compatible endpoint.
STUDENT_API_BASE=http://127.0.0.1:8000/v1

# The remote expert E: any OpenAI-compatible chat endpoint and the model name the configs' `cloud_model` refers to.
CLOUD_API_BASE=https://openrouter.ai/api/v1
CLOUD_API_KEY=sk-...
CLOUD_EXPERT_MODEL=deepseek/deepseek-v3.2

# The offline teacher R (data construction only). A separate model from the expert.
TEACHER_API_BASE=https://openrouter.ai/api/v1
TEACHER_API_KEY=sk-...
TEACHER_MODEL=

# Apptainer images: sweb.eval.x86_64.<instance>.sif (SWE-bench Verified), swesmith.x86_64.<repo>.sif (SWE-smith),
# and tb2/<task>.sif (Terminal-Bench, built by uva/eval/terminalbench/build_tb2_images.sh).
UVA_SIF_CACHE_DIR=containers

# Consulting policies send the student's question off the machine verbatim. Set to 1 only for public benchmarks.
UVA_ACK_PUBLIC_BENCHMARK=0
